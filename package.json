{
  "name": "brafflex-controle",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:local": "wrangler d1 migrations apply brafflex-controle --local",
    "db:remoto": "wrangler d1 migrations apply brafflex-controle --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "@tailwindcss/vite": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.18",
    "jose": "6.2.17",
    "lucide-react": "0.577.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.69.1",
    "@cloudflare/vitest-plugin": "1.8.2",
    "@vitejs/plugin-react": "5.2.0",
    "drizzle-kit": "0.31.11",
    "vite": "7.3.6",
    "vitest": "4.1.12",
    "wrangler": "4.162.0"
  }
}
